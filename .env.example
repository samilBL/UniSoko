# Admin credentials: use a unique high-entropy password; never commit real values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234567890
# At least 32 random characters. Required to sign secure admin sessions.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Public canonical origin used for metadata and sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://unisoko.co.tz

# Supabase project URL and public client key (anon or publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the project's anon key, or set NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# Server-only key for trusted API operations. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-secret
