# Admin credentials: use a unique high-entropy password; never commit real values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234567890
# At least 32 random characters. Required to sign secure admin sessions.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Supabase project (trade-in persistence, private photo storage, and campus vote analytics)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-secret
